# Copy to .env only for the local demo. Use real secret management in deployment.
# Generate SRS_EAM_PASSWORD; scripts/stack.sh generates a disposable one if unset.
# API_TOKEN is optional for the isolated demo, but required for carrier/airfield control.
API_TOKEN=
ATC_WIND_FROM_DEG=0
WHISPER_THREADS=4
PIPER_THREADS=4

# Optional local intent fallback; endpoint must be loopback/private LAN.
# Use a model already installed in your local inference server.
LLM_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=3
AWACS_BULLSEYE=
AWACS_HOME_AIRFIELD=

# Enable live JTAC by setting BRAIN_ROLES=awacs,atc,jtac and a fresh bridge token.
# Start the second gateway with Compose profile "jtac".
BRAIN_ROLES=awacs,atc
COALITION=2
SRS_FREQUENCY_HZ=251000000
SRS_MODULATION=0
JTAC_CALLSIGN=Axeman
JTAC_SRS_FREQUENCY_HZ=252000000
JTAC_SRS_MODULATION=0
DCS_BRIDGE_TOKEN=
DCS_STALE_SECONDS=10
# compose.local-ai.yaml publishes only to loopback unless explicitly overridden.
BRAIN_BIND_ADDRESS=127.0.0.1

# Carrier frequencies/modulation are read from each ship's mission configuration.
# Add carrier to BRAIN_ROLES, set both tokens, and use Compose profile carrier.
# Configure hook features={"jtac","carriers"} (or {"carriers"} without JTAC).
# Optional server-only coalition password map; never copy it into a mission.
SRS_EAM_PASSWORDS=
CARRIER_GATEWAY_POLL_SECONDS=1
CARRIER_GATEWAY_STALE_SECONDS=15

# Native airfield ATC: add airfield to BRAIN_ROLES and enable profile airfield.
# Replaces legacy shared-radio atc when enabled; requires both tokens.
# Private server hook: features={"airfields"} (or add it alongside jtac/carriers).
# Read native terrain Radio.lua through hook config, never duplicate frequency lists.
AIRFIELD_GATEWAY_POLL_SECONDS=1
AIRFIELD_GATEWAY_STALE_SECONDS=15
